# Required: create a new Telegram bot via @BotFather.
BOT_TOKEN=1234567890:replace_with_real_token

# Recommended: send /whoami to the bot and paste your Telegram user ID.
OWNER_USER_ID=

# Used as the default timezone for newly created events.
TIMEZONE=Europe/Moscow

# Do not change unless you understand why.
STATE_FILE=/var/lib/sborum-bot/state.json
